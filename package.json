{
    "name": "md-browser-editor",
    "version": "0.2.1",
    "description": "Browse a markdown tree in your browser, edit it in a live-preview editor, and leave mentions for an AI agent to act on.",
    "keywords": [
        "markdown",
        "editor",
        "codemirror",
        "live-preview",
        "docs-as-code",
        "ai",
        "agent"
    ],
    "license": "MIT",
    "author": "alagrede (https://github.com/alagrede)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alagrede/md-browser-editor.git"
    },
    "bugs": {
        "url": "https://github.com/alagrede/md-browser-editor/issues"
    },
    "homepage": "https://github.com/alagrede/md-browser-editor#readme",
    "type": "module",
    "bin": {
        "md-browser-editor": "bin/cli.mjs"
    },
    "exports": {
        ".": "./src/index.mjs"
    },
    "files": [
        "bin",
        "src",
        "public",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "node build.mjs",
        "test": "node --test test/*.test.mjs",
        "serve": "node bin/cli.mjs serve",
        "prepublishOnly": "npm run build && npm test"
    },
    "devDependencies": {
        "@codemirror/commands": "^6.7.1",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.3.1",
        "@codemirror/language": "^6.10.8",
        "@codemirror/legacy-modes": "^6.5.4",
        "@codemirror/state": "^6.5.0",
        "@codemirror/view": "^6.36.1",
        "@lezer/highlight": "^1.2.1",
        "@lezer/markdown": "^1.4.1",
        "esbuild": "^0.24.2"
    }
}
